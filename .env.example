AGENT_RUNTIME_PROVIDER=GOOGLE_GEMINI
AGENT_RUNTIME_MODEL=gemini-3.6-flash
AGENT_RUNTIME_MAX_TURNS=8
AGENT_RUNTIME_MAX_AGENT_DEPTH=3
AGENT_RUNTIME_MAX_AGENT_INVOCATIONS=10
AGENT_RUNTIME_HUMAN_INTERACTION_RESUME_POLL_MS=1000
AGENT_TEST_INTERACTION_TOKEN_SECRET=replace-with-at-least-32-random-characters
AGENT_TEST_INTERACTION_TOKEN_TTL=30m

# Keep false only for local development. When true, configure one standard Spring JWT source.
AGENT_SECURITY_ENABLED=false
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-sol

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash

# Hosts that HTTP tools may call. Empty means every HTTP tool fails with
# "HTTP tool host is not allowlisted". Supports a leading wildcard, e.g. *.example.com
# The two entries below are what examples/weather-agent needs. examples/trading-desk-agent
# additionally needs host.docker.internal, where its sidecar runs:
#   AGENT_HTTP_TOOL_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com,host.docker.internal
AGENT_HTTP_TOOL_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com
