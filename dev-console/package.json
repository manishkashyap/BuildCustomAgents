{
  "name": "agent-platform-dev-console",
  "private": true,
  "version": "0.1.0",
  "description": "Developer console for testing and validating the Custom Agent Platform: tool and agent authoring, draft and published runs, turn-by-turn traces, and human-in-the-loop.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "stub-llm": "node stub-llm/server.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
