      "conditions": [
        {
          "id": "broke_the_range",
          "tf": "15m",
          "op": "is_true",
          "long": "conditions.closedAboveTwentyBarHigh",
          "short": "conditions.closedBelowTwentyBarLow"
        },
        {
          "id": "breakout_volume",
          "tf": "15m",
          "op": "gte",
          "field": "volume.ratioToAverage",
          "value": 1.5
        },
        {
          "id": "bands_expanding",
          "tf": "15m",
          "op": "compare_field",
          "left": "volatility.bollingerBandwidth",
          "right": "volatility.bollingerBandwidthTwentyBarsAgo",
          "comparison": "gt"
        },
        {
          "id": "setup_adx",
          "tf": "15m",
          "op": "gte",
          "field": "trendStrength.adx14",
          "value": 20
