{
  "version": 2,
  "note": "The nine strategies as data. Prose conditions from the agent's context.strategyCatalogue, re-expressed as predicates the executor evaluates directly. Direction-parameterised conditions carry separate long and short values; a condition with neither applies to both. Each strategy also carries a stopRule, because a single swing-based stop applied to every strategy put breakout stops hundreds of points away and the desk rejected them on stop_within_atr_budget.",
  "strategies": [
    {
      "name": "trend_continuation",
      "directions": [
        "LONG",
        "SHORT"
      ],
      "requiredRegime": [
        "STRONG_UPTREND",
        "STRONG_DOWNTREND"
      ],
      "stop": "beyond the most recent 15m swing low (long) or swing high (short)",
      "target": "short of the nearest opposing 1h zone",
      "conditions": [
        {
          "id": "daily_adx",
          "tf": "1d",
          "op": "gte",
          "field": "trendStrength.adx14",
          "value": 25
        },
        {
          "id": "hourly_adx",
          "tf": "1h",
          "op": "gte",
          "field": "trendStrength.adx14",
          "value": 25
        },
        {
          "id": "daily_di_agrees",
          "tf": "1d",
          "op": "compare_field",
          "left": "trendStrength.plusDi",
          "right": "trendStrength.minusDi",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "hourly_di_agrees",
          "tf": "1h",
          "op": "compare_field",
          "left": "trendStrength.plusDi",
          "right": "trendStrength.minusDi",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "hourly_above_ema50",
          "tf": "1h",
          "op": "compare_field",
          "left": "close",
          "right": "movingAverages.ema50",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "hourly_above_ema200",
          "tf": "1h",
          "op": "compare_field",
          "left": "close",
          "right": "movingAverages.ema200",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "hourly_structure",
          "tf": "1h",
          "op": "equals",
          "field": "structure.classification",
          "long": "HIGHER_HIGHS_HIGHER_LOWS",
          "short": "LOWER_HIGHS_LOWER_LOWS"
        },
        {
          "id": "setup_macd_sign",
          "tf": "15m",
          "op": "sign_is",
          "field": "momentum.macdHistogram",
          "long": "positive",
          "short": "negative"
        },
        {
          "id": "setup_macd_strengthening",
          "tf": "15m",
          "op": "compare_field",
          "left": "momentum.macdHistogram",
          "right": "momentum.macdHistogramThreeBarsAgo",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "entry_beyond_swing",
          "tf": "5m",
          "op": "beyond_swing",
          "field": "close",
          "long": "structure.lastSwingHighs.0",
          "short": "structure.lastSwingLows.0"
        },
        {
          "id": "entry_volume",
          "tf": "5m",
          "op": "gte",
          "field": "volume.ratioToAverage",
          "value": 1.2
        }
      ],
      "stopRule": {
        "tf": "15m",
        "long": "structure.lastSwingLows.0",
        "short": "structure.lastSwingHighs.0",
        "cushion": 0.1,
        "note": "beyond the most recent 15m swing against the trade"
      }
    },
    {
      "name": "pullback_in_trend",
      "directions": [
        "LONG",
        "SHORT"
      ],
      "requiredRegime": [
        "STRONG_UPTREND",
        "WEAK_UPTREND",
        "STRONG_DOWNTREND",
        "WEAK_DOWNTREND"
      ],
      "stop": "beyond the pullback extreme plus 0.25 x 15m atr14",
      "target": "the prior 15m swing extreme in the trend direction",
      "conditions": [
        {
          "id": "hourly_trend_side",
          "tf": "1h",
          "op": "compare_field",
          "left": "close",
          "right": "movingAverages.ema50",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "near_an_anchor",
          "tf": "15m",
          "op": "within_atr_of",
          "field": "close",
          "anchors": [
            "movingAverages.ema20",
            "movingAverages.ema50"
          ],
          "zones": true,
          "minTouches": 2,
          "multiple": 1.0
        },
        {
          "id": "setup_rsi_band",
          "tf": "15m",
          "op": "between",
          "field": "momentum.rsi14",
          "long": [
            40,
            55
          ],
          "short": [
            45,
            60
          ]
        },
        {
          "id": "setup_rsi_turning_back",
          "tf": "15m",
          "op": "moved_toward",
          "field": "momentum.rsi14",
          "from": "momentum.rsi14FiveBarsAgo",
          "target": 50
        },
        {
          "id": "entry_wick_rejection",
          "tf": "5m",
          "op": "is_true",
          "long": "conditions.lowerWickRejection",
          "short": "conditions.upperWickRejection"
        }
      ],
      "stopRule": {
        "tf": "15m",
        "long": "structure.lastSwingLows.0",
        "short": "structure.lastSwingHighs.0",
        "cushion": 0.25,
        "note": "beyond the pullback extreme plus 0.25 x 15m atr14"
      }
    },
    {
      "name": "support_resistance_breakout",
      "directions": [
        "LONG",
        "SHORT"
      ],
      "requiredRegime": [
        "BREAKOUT_EXPANSION",
        "STRONG_UPTREND",
        "STRONG_DOWNTREND",
        "RANGE_BOUND"
      ],
      "stop": "the far side of the breakout candle",
