        {
          "id": "close_on_breakout_side",
          "tf": "15m",
          "op": "compare_field",
          "left": "close",
          "right": "volatility.bollingerMiddle",
          "long": "gt",
          "short": "lt"
        },
        {
          "id": "entry_wick_rejection",
          "tf": "5m",
          "op": "is_true",
          "long": "conditions.lowerWickRejection",
          "short": "conditions.upperWickRejection"
        },
        {
          "id": "entry_volume",
          "tf": "5m",
          "op": "gte",
          "field": "volume.ratioToAverage",
          "value": 1.0
        },
        {
          "id": "hourly_macd_agrees",
          "tf": "1h",
          "op": "sign_is",
          "field": "momentum.macdHistogram",
          "long": "positive",
          "short": "negative"
        }
      ],
      "stopRule": {
        "tf": "5m",
        "long": "structure.lastSwingLows.0",
        "short": "structure.lastSwingHighs.0",
        "cushion": 0.25,
        "note": "beyond the retest wick"
      }
    },
